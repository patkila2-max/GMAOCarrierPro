      (tech) => `
        <article class="team-card">
          <div class="topline">
            <h4>${tech.name}</h4>
            <span class="badge ${tech.availability === 'Available' ? 'good' : tech.availability === 'In transit' ? 'watch' : 'critical'}">${tech.availability}</span>
          </div>
          <p class="team-meta">${tech.role}</p>
          <p class="team-meta">Assigned jobs: ${tech.assigned}</p>
        </article>
      `
    )
    .join('');
}

function renderInventory(inventory) {
  const container = document.getElementById('inventoryTable');
  if (!container) return;

  container.innerHTML = inventory
    .map((item) => {
      const badgeClass = item.status.toLowerCase() === 'low' ? 'low' : item.status.toLowerCase() === 'ordered' ? 'ordered' : 'ready';
      return `
        <tr>
          <td>${item.id}</td>
          <td>${item.name}</td>
          <td>${item.sku}</td>
          <td>${item.quantity}</td>
          <td>${item.location}</td>
          <td><span class="inventory-badge ${badgeClass}">${item.status}</span></td>
        </tr>
      `;
    })
    .join('');
}

function renderActivity(logEntries) {
